# Copy to .env. Values here are local-only and safe to commit as an example;
# nothing in this file is ever used outside docker compose.
DATABASE_URL=postgres://nook:nook_local_only@localhost:55432/nook
REDIS_URL=redis://localhost:56379
S3_ENDPOINT=http://localhost:59000
S3_BUCKET=nook-attachments
S3_ACCESS_KEY=nook
S3_SECRET_KEY=nook_local_only
JWT_SECRET=local_dev_secret_replace_in_every_real_environment
LOG_LEVEL=info
